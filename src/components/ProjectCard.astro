---
import type { CollectionEntry } from 'astro:content';
const { project, lang } = Astro.props as { project: CollectionEntry<'projects'>; lang: string };
const { title, description, featured, repo, install, tech } = project.data;
const slug = project.id.split('/')[1];
const base = lang === 'fr' ? '/fr' : '';
const href = featured ? `${base}/projects/${slug}` : repo;
---
<article class="group relative bg-glass border border-line rounded-2xl p-5 flex flex-col gap-2.5 transition-colors hover:border-accent">
  <a href={repo} class="absolute top-4 right-5 text-accent text-sm opacity-60 group-hover:opacity-100 transition-opacity" aria-label="GitHub">↗</a>
  <h3 class="font-semibold pr-6"><a href={href} class="group-hover:text-accent transition-colors">{title}</a></h3>
  <p class="text-[13px] leading-relaxed text-muted">{description}</p>
  {install && <code class="font-mono text-[11px] bg-bg border-l-3 border-accent px-2.5 py-2 text-muted overflow-x-auto whitespace-nowrap"><span class="text-accent select-none">$ </span>{install}</code>}
  <div class="mt-auto pt-1 flex flex-wrap gap-1.5">
    {tech.map((t: string) => <span class="font-mono text-[10px] px-2 py-0.5 rounded-full border border-line text-faint">{t}</span>)}
  </div>
</article>
